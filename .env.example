# Copy this file to `.env` and fill in your real values.
# `.env` is gitignored — it never goes to GitHub. Each device needs its own.
#
# Find these in Supabase: Project Settings -> API
#   PUBLIC_SUPABASE_URL      = your Project URL   (https://xxxx.supabase.co)
#   PUBLIC_SUPABASE_ANON_KEY = your anon/public key (starts with eyJ...)
#
# The anon key is meant to be public (it ships in the browser).
# NEVER put the service_role key in here.

PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
