---
import { nav, site } from "../site.config";
const path = Astro.url.pathname;

// Split the nav around the centerpiece (The Table).
// Items before center go left, center is the middle, items after go right.
// With About, The Table, Comms, Contact/Tips in the config, that gives
// About(L) · Table · Comms+Contact(R). Reorder `nav` in site.config.ts to rebalance.
const centerIndex = nav.findIndex((i) => i.center);
const left = centerIndex >= 0 ? nav.slice(0, centerIndex) : nav;
const center = centerIndex >= 0 ? nav[centerIndex] : null;
const right = centerIndex >= 0 ? nav.slice(centerIndex + 1) : [];

const isActive = (href) =>
  path === href || (href !== "/" && path.startsWith(href));
---

<header class="nav">
  <a class="wordmark" href="/">{site.wordmark}</a>

  <nav class="links" aria-label="Primary">
    <div class="side side-left">
      {left.map((item) => (
        <a href={item.href}
           class:list={["link", { active: isActive(item.href) }]}
           aria-current={isActive(item.href) ? "page" : undefined}>
          {item.label}
        </a>
      ))}
    </div>

    {center && (
      <a href={center.href}
         class:list={["link", "center", { active: isActive(center.href) }]}
         aria-current={isActive(center.href) ? "page" : undefined}>
        {center.label}
      </a>
    )}

    <div class="side side-right">
      {right.map((item) => (
        <a href={item.href}
           class:list={["link", { active: isActive(item.href) }]}
           aria-current={isActive(item.href) ? "page" : undefined}>
          {item.label}
        </a>
      ))}
    </div>
  </nav>
</header>

<style>
  /* ─────────────────────────────────────────────────────────
     BASE = PHONE. Single column, everything centered.
     (The layout you liked on the phone; untouched.)
     ───────────────────────────────────────────────────────── */
  .nav {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    padding: 0.9rem 1rem;
    border-bottom: 1px solid var(--line);
    background: rgba(20, 23, 26, 0.7);
    backdrop-filter: blur(8px);
    position: sticky;
    top: 0;
    z-index: 40;
  }

  /* ── WORDMARK (site title) ──────────────────────────────
     KNOB: font-size = how big. letter-spacing = how spread. */
  .wordmark {
    font-family: var(--display);
    font-size: 1.25rem;          /* phone size */
    letter-spacing: 0.14em;
    color: var(--snowmelt);
    text-align: center;
  }

  .links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    font-family: var(--mono);
    font-size: 0.74rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  /* On phone the left/right groups are just inline runs of links. */
  .side { display: contents; }

  .link {
    color: var(--sage);
    padding: 0.3rem 0;
    border-bottom: 1px solid transparent;
    transition: color 0.2s ease, border-color 0.2s ease;
    white-space: nowrap;
  }
  .link:hover { color: var(--snowmelt); }
  .link.active { color: var(--snowmelt); border-bottom-color: var(--oxide); }

  /* The Table — the centerpiece. Larger, oxide-lit. */
  .link.center {
    font-size: 0.92rem;
    letter-spacing: 0.16em;
    color: var(--snowmelt);
    padding: 0.35rem 1rem;
    border: 1px solid var(--line);
    border-radius: 2px;
  }
  .link.center:hover { border-color: var(--oxide); background: rgba(192, 90, 46, 0.06); }
  .link.center.active { border-color: var(--oxide); }

  /* ─────────────────────────────────────────────────────────
     DESKTOP (>=860px): title centered + large on top,
     links row below split around The Table.
     Phone view above is untouched by everything in here.
     ───────────────────────────────────────────────────────── */
  @media (min-width: 860px) {
    .nav {
      padding: 1.4rem 2rem 1rem;
      gap: 1rem;
    }

    /* KNOB: desktop title size. Try 1.8-2.8rem. */
    .wordmark {
      font-size: 2.1rem;
      letter-spacing: 0.16em;
    }

    /* links row: [left group] [ The Table ] [right group]
       three-column grid centers The Table on the page. */
    .links {
      width: 100%;
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 2rem;
      flex-wrap: nowrap;
    }
    .side {
      display: flex;
      align-items: center;
      gap: 1.6rem;
    }
    .side-left  { justify-content: flex-end; }
    .side-right { justify-content: flex-start; }
  }
</style>
