---
// ─────────────────────────────────────────────────────────────
//  AuthButton — Sign in with Google, sign in with magic link,
//  signed-in state, sign out.
//
//  COLOR KNOBS live at the top of the style block below.
//  Change those variables to restyle the whole component.
// ─────────────────────────────────────────────────────────────
---

<div class="auth" data-auth-root>
  <!-- signed-out view -->
  <div class="auth-out-wrap" data-auth-signed-out hidden>
    <button class="auth-btn" type="button" data-auth-signin>
      <span class="g" aria-hidden="true">G</span>
      Sign in with Google
    </button>

    <div class="auth-divider" aria-hidden="true"><span>or</span></div>

    <form class="magic-form" data-auth-magic-form>
      <input
        class="magic-input"
        type="email"
        name="email"
        placeholder="you@example.com"
        autocomplete="email"
        required
        data-auth-magic-email
      />
      <button class="magic-btn" type="submit" data-auth-magic-submit>
        <span class="lock" aria-hidden="true">🔒</span>
        Send magic link
      </button>
    </form>

    <p class="magic-sent" data-auth-magic-sent hidden>
      Check your email for a sign-in link.
    </p>
    <p class="magic-error" data-auth-magic-error hidden></p>
  </div>

  <!-- terms notice, shown only when signed out -->
  <p class="terms-note" data-auth-terms hidden>
    Signing in means you agree to our
    <a href="/terms">terms</a> and <a href="/privacy">privacy policy</a>.
  </p>

  <!-- signed-in view -->
  <div class="auth-in" data-auth-user hidden>
    <span class="who">
      <span class="who-label">signed in as</span>
      <span class="who-name" data-auth-name>—</span>
    </span>
    <button class="auth-out" type="button" data-auth-signout>Sign out</button>
  </div>

  <!-- while we check the session -->
  <span class="auth-wait" data-auth-loading>…</span>
</div>

<script>
  import { supabase } from "../lib/supabase";

  const root       = document.querySelector("[data-auth-root]");
  const outWrapEl  = root.querySelector("[data-auth-signed-out]");
  const signInEl   = root.querySelector("[data-auth-signin]");
  const userEl     = root.querySelector("[data-auth-user]");
  const nameEl     = root.querySelector("[data-auth-name]");
  const outEl      = root.querySelector("[data-auth-signout]");
  const waitEl     = root.querySelector("[data-auth-loading]");
  const termsEl    = root.querySelector("[data-auth-terms]");
  const magicForm  = root.querySelector("[data-auth-magic-form]");
  const magicEmail = root.querySelector("[data-auth-magic-email]");
  const magicBtn   = root.querySelector("[data-auth-magic-submit]");
  const magicSent  = root.querySelector("[data-auth-magic-sent]");
  const magicError = root.querySelector("[data-auth-magic-error]");

  function render(session) {
    waitEl.hidden = true;
    if (session?.user) {
      const u = session.user;
      nameEl.textContent =
        u.user_metadata?.full_name || u.user_metadata?.name || u.email || "friend";
      userEl.hidden = false;
      outWrapEl.hidden = true;
      if (termsEl) termsEl.hidden = true;
    } else {
      userEl.hidden = true;
      outWrapEl.hidden = false;
      if (termsEl) termsEl.hidden = false;
    }
  }

  const { data } = await supabase.auth.getSession();
  render(data.session);

  supabase.auth.onAuthStateChange((_event, session) => render(session));

  signInEl.addEventListener("click", async () => {
    const { error } = await supabase.auth.signInWithOAuth({
      provider: "google",
      options: { redirectTo: window.location.origin + window.location.pathname },
    });
    if (error) console.error("[auth] sign-in failed:", error.message);
  });

  magicForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    magicError.hidden = true;
    magicSent.hidden = true;

    const email = magicEmail.value.trim();
    if (!email) return;

    magicBtn.disabled = true;
    const { error } = await supabase.auth.signInWithOtp({
      email,
      options: { emailRedirectTo: window.location.origin + window.location.pathname },
    });
    magicBtn.disabled = false;

    if (error) {
      magicError.textContent = "Couldn't send that link — try again in a moment.";
      magicError.hidden = false;
      console.error("[auth] magic link failed:", error.message);
      return;
    }
    magicForm.hidden = true;
    magicSent.hidden = false;
  });

  outEl.addEventListener("click", async () => {
    const { error } = await supabase.auth.signOut();
    if (error) console.error("[auth] sign-out failed:", error.message);
    render(null);
  });
</script>

<style>
  /* ═══ COLOR KNOBS — change these to restyle ═══════════════ */
  .auth {
    --auth-name-color:    #7aa7d9;
    --auth-label-color:   var(--sage);
    --auth-signout-color: #d9a441;
    --auth-signout-hover: #f0c368;
    --auth-google-g:      #4285F4;
    --auth-btn-text:      var(--snowmelt);
    --auth-btn-border:    var(--line);
    --auth-btn-hover:     var(--oxide);

    --auth-magic-color:   #2f9e8f;
    --auth-magic-hover:   #3fc0af;
    --auth-magic-text:    var(--basalt);
  }
  /* ═════════════════════════════════════════════════════════ */

  [hidden] { display: none !important; }

  .auth {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
  }

  .auth-out-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.7rem;
    width: 100%;
    max-width: 280px;
  }

  .auth-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--auth-btn-text);
    background: transparent;
    border: 1px solid var(--auth-btn-border);
    border-radius: 3px;
    padding: 0.5rem 0.9rem;
    cursor: pointer;
    width: 100%;
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  .auth-btn:hover {
    border-color: var(--auth-btn-hover);
    background: rgba(192, 90, 46, 0.06);
  }

  .g {
    font-family: var(--display);
    font-size: 1rem;
    font-weight: 700;
    color: var(--auth-google-g);
    line-height: 1;
  }

  .auth-divider {
    display: flex;
    align-items: center;
    width: 100%;
    color: var(--sage);
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.6;
  }
  .auth-divider::before,
  .auth-divider::after {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--line);
  }
  .auth-divider span { padding: 0 0.6rem; }

  .magic-form {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;
  }

  .magic-input {
    font-family: var(--body);
    font-size: 0.85rem;
    color: var(--snowmelt);
    background: var(--basalt-2);
    border: 1px solid var(--line);
    border-radius: 3px;
    padding: 0.5rem 0.7rem;
    width: 100%;
  }
  .magic-input:focus {
    outline: none;
    border-color: var(--auth-magic-color);
  }

  .magic-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--auth-magic-text);
    background: var(--auth-magic-color);
    border: 1px solid var(--auth-magic-color);
    border-radius: 3px;
    padding: 0.55rem 0.9rem;
    cursor: pointer;
    width: 100%;
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.15s ease;
  }
  .magic-btn:hover {
    background: var(--auth-magic-hover);
    border-color: var(--auth-magic-hover);
    transform: translateY(-1px);
  }
  .magic-btn:disabled { opacity: 0.6; cursor: default; transform: none; }
  .lock { font-size: 0.8rem; line-height: 1; }

  .magic-sent {
    font-family: var(--body);
    font-size: 0.8rem;
    color: var(--auth-magic-color);
    text-align: center;
    margin: 0;
  }
  .magic-error {
    font-family: var(--body);
    font-size: 0.78rem;
    color: var(--heat-c4, #d93b1f);
    text-align: center;
    margin: 0;
  }

  .auth-in { display: flex; align-items: center; gap: 1rem; }
  .who { display: flex; align-items: baseline; gap: 0.45rem; }
  .who-label {
    color: var(--auth-label-color);
    text-transform: uppercase;
    font-size: 0.62rem;
  }
  .who-name {
    color: var(--auth-name-color);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  .auth-out {
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--auth-signout-color);
    background: transparent;
    border: 1px solid var(--auth-signout-color);
    border-radius: 3px;
    padding: 0.35rem 0.7rem;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }
  .auth-out:hover {
    color: var(--auth-signout-hover);
    border-color: var(--auth-signout-hover);
    background: rgba(217, 164, 65, 0.08);
  }

  .auth-wait { color: var(--sage); opacity: 0.6; }

  .terms-note {
    font-family: var(--body);
    font-size: 0.78rem;
    line-height: 1.4;
    color: var(--sage);
    margin: 0;
    max-width: 30ch;
    text-align: center;
  }
  .terms-note a {
    color: #e0c85a;
    border-bottom: 1px solid rgba(224, 200, 90, 0.4);
  }
  .terms-note a:hover { color: #f5e08a; border-bottom-color: #f5e08a; }
</style>