---
import Base from "./Base.astro";
import Nav from "../components/Nav.astro";
import StatusLine from "../components/StatusLine.astro";
interface Props {
  title?: string;
  description?: string;
}
const { title, description } = Astro.props;
---

<Base title={title} description={description}>
  <Nav />

  <!-- Wave divider: a straight line with a bright oxide pulse that
       sweeps across it, left to right. Stops for reduced-motion. -->
  <div class="wavediv" aria-hidden="true">
    <span class="wavediv-pulse"></span>
  </div>

  <!-- The standing line, every page. Italic Newsreader, centered. -->
  <p class="creed">
    Protecting the vulnerable with Community Resilience
    <span class="creed-sep">~</span> off-grid connections
    <span class="creed-sep">~</span> Creative Power Solutions
  </p>

  <div class="page">
    <slot />
  </div>
    <!-- Site footer: the standing links. -->
  <footer class="sitefoot">
    <nav class="foot-links" aria-label="Site information">
      <a href="/about">About</a>
      <span class="foot-sep" aria-hidden="true">·</span>
      <a href="/privacy">Privacy</a>
      <span class="foot-sep" aria-hidden="true">·</span>
      <a href="/terms">Terms</a>
      <span class="foot-sep" aria-hidden="true">·</span>
      <a href="/contact">Contact / Tips</a>
    </nav>
    <p class="foot-note">
      Blaine County Preparedness — a neighbors' site.
    </p>
  </footer>

  <StatusLine />
</Base>

<style>
  /* ── WAVE DIVIDER ──────────────────────────────────────── */
  .wavediv {
    position: relative;
    height: 1px;
    width: 100%;
    background: var(--line);           /* the straight divider */
    overflow: hidden;
  }
  /* a short bright oxide segment that sweeps across the line */
  .wavediv-pulse {
    position: absolute;
    top: -1px;                          /* sit over the 1px line */
    left: 0;
    height: 3px;
    width: 120px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      var(--oxide) 50%,
      transparent 100%
    );
    filter: drop-shadow(0 0 4px rgba(192, 90, 46, 0.7));
    animation: sweep 6s linear infinite;
  }
  @keyframes sweep {
    0%   { transform: translateX(-120px); }
    100% { transform: translateX(100vw); }
  }
  @media (prefers-reduced-motion: reduce) {
    .wavediv-pulse { display: none; }  /* still line for reduced-motion */
  }

  /* ── CREED STRIP ───────────────────────────────────────── */
  .creed {
    margin: 0;
    padding: 0.55rem 1.2rem;
    text-align: center;
    font-family: var(--body);
    font-style: italic;
    font-size: 0.82rem;
    line-height: 1.4;
    color: var(--sage);
    border-bottom: 1px solid var(--line);
  }
  .creed-sep { color: var(--oxide); font-style: normal; padding: 0 0.15rem; }

  @media (max-width: 560px) {
    .creed { font-size: 0.76rem; }
  }

  .page {
    max-width: var(--wrap);
    margin: 0 auto;
    padding: 2.4rem 1.6rem 5rem;
    min-height: 60vh;
  }
    /* ── SITE FOOTER ──────────────────────────────────────────
     KNOB: --foot-link is the link colour. */
  .sitefoot {
    --foot-link: #e0c85a;
    --foot-link-hover: #f5e08a;
    border-top: 1px solid var(--line);
    margin-top: 4rem;
    padding: 2.2rem 1.4rem 2.6rem;
    text-align: center;
  }
  .foot-links {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.7rem;
    font-family: var(--mono);
    font-size: 0.74rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .foot-links a {
    color: var(--foot-link);
    border-bottom: 1px solid transparent;
    padding-bottom: 2px;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .foot-links a:hover {
    color: var(--foot-link-hover);
    border-bottom-color: var(--foot-link-hover);
  }
  .foot-sep { color: var(--sage); opacity: 0.5; }
  .foot-note {
    font-family: var(--body);
    font-style: italic;
    font-size: 0.85rem;
    color: var(--sage);
    opacity: 0.75;
    margin: 1rem 0 0;
  }
</style>
