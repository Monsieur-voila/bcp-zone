---
// ─────────────────────────────────────────────────────────────
//  AuthButton — Sign in with Google / signed-in state / sign out.
//
//  STAGE A: proves a real person can sign in and the site knows
//  who they are. No forum logic yet.
//
//  The script block below runs entirely in the browser.
// ─────────────────────────────────────────────────────────────
---

<div class="auth" data-auth-root>
  <!-- signed-out view -->
  <button class="auth-btn" data-auth-signin hidden>
    <span class="g" aria-hidden="true">G</span>
    Sign in with Google
  </button>

  <!-- signed-in view -->
  <div class="auth-in" data-auth-user hidden>
    <span class="who">
      <span class="who-label">signed in as</span>
      <span class="who-name" data-auth-name>—</span>
    </span>
    <button class="auth-out" data-auth-signout>Sign out</button>
  </div>

  <!-- while we check the session -->
  <span class="auth-wait" data-auth-loading>…</span>
</div>

<script>
  import { supabase } from "../lib/supabase";

  const root     = document.querySelector("[data-auth-root]");
  const signInEl = root.querySelector("[data-auth-signin]");
  const userEl   = root.querySelector("[data-auth-user]");
  const nameEl   = root.querySelector("[data-auth-name]");
  const outEl    = root.querySelector("[data-auth-signout]");
  const waitEl   = root.querySelector("[data-auth-loading]");

  // Show the right view for the current session.
  function render(session) {
    waitEl.hidden = true;
    if (session?.user) {
      const u = session.user;
      // Prefer the person's name; fall back to email.
      nameEl.textContent =
        u.user_metadata?.full_name || u.user_metadata?.name || u.email || "friend";
      userEl.hidden = false;
      signInEl.hidden = true;
    } else {
      userEl.hidden = true;
      signInEl.hidden = false;
    }
  }

  // Check session on load.
  const { data } = await supabase.auth.getSession();
  render(data.session);

  // React to sign in / sign out as it happens.
  supabase.auth.onAuthStateChange((_event, session) => render(session));

  // Sign in — sends the person to Google, then back here.
  signInEl.addEventListener("click", async () => {
    const { error } = await supabase.auth.signInWithOAuth({
      provider: "google",
      options: { redirectTo: window.location.origin + window.location.pathname },
    });
    if (error) console.error("[auth] sign-in failed:", error.message);
  });

  // Sign out.
  outEl.addEventListener("click", async () => {
    const { error } = await supabase.auth.signOut();
    if (error) console.error("[auth] sign-out failed:", error.message);
  });
</script>

<style>
  .auth {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
  }

  .auth-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--snowmelt);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 3px;
    padding: 0.5rem 0.9rem;
    cursor: pointer;
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  .auth-btn:hover { border-color: var(--oxide); background: rgba(192, 90, 46, 0.06); }

  .g {
    font-family: var(--display);
    font-size: 0.95rem;
    color: var(--oxide);
    line-height: 1;
  }

  .auth-in { display: flex; align-items: center; gap: 0.8rem; }
  .who { display: flex; align-items: baseline; gap: 0.4rem; }
  .who-label { color: var(--sage); text-transform: uppercase; font-size: 0.62rem; }
  .who-name  { color: var(--snowmelt); font-size: 0.76rem; }

  .auth-out {
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sage);
    background: transparent;
    border: none;
    border-bottom: 1px solid transparent;
    padding: 0.1rem 0;
    cursor: pointer;
  }
  .auth-out:hover { color: var(--oxide); border-bottom-color: var(--oxide); }

  .auth-wait { color: var(--sage); opacity: 0.6; }
</style>
